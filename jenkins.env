# Jenkins Environment Variables
DOCKER_ENV=true
JWT_SECRET=your_secure_jwt_secret_for_production
NODE_ENV=production

# MongoDB Configuration
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=capstone-project

# API Configuration
SERVER_PORT=5000
ML_API_PORT=6000
CLIENT_PORT=3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_AUTHORIZED_ORIGINS=http://localhost:3000,http://client:3000

# Docker Registry
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=vigucs
# Add DOCKER_PASSWORD as a Jenkins credential 